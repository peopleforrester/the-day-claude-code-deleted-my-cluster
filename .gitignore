# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*~

# Python (for any helper scripts)
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node (if any slide tooling uses it)
node_modules/
npm-debug.log*

# Local-only drafts that shouldn't ship
scratch/
drafts-local/

# Submitted under "visible to organizers only" — captured locally,
# not published. Remove this line deliberately to publish.
abstract/speaker-notes-organizers.md

# Internal session/state narrative — useful for local Claude Code
# sessions (state-persistence rule), noise for students reading the
# published repo. The files stay on disk; just not pushed.
MEMORY.md
docs/senior-review-fixes.md

# Per-project Claude Code state directory (caches, transient state).
# Not for publication.
.claude/

# Slide-tool intermediates (commit source, ignore derived output)
.reveal-md/
_site/
dist/
build/

# Office / Keynote lock files and autosaves
~$*.pptx
~$*.key
*.pptx~
*.key~

# LaTeX / Beamer build artifacts
*.aux
*.log
*.toc
*.nav
*.snm
*.out
*.synctex.gz

# Rehearsal recordings
*.wav
*.m4a
*.aif
*.aiff

# Large media exports (keep source decks, skip derived exports)
*.mp4
*.mov

# PDF policy: exports are derived, so ignore them under
# presentations/ and outline/. If a publishable PDF deliverable is
# produced for a venue, add it under post-event/ where it is not
# blanket-ignored.
presentations/*.pdf
outline/*.pdf
recordings/
