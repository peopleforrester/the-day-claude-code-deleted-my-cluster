#!/usr/bin/env bash
# ABOUTME: Enforce Conventional Commits. Require human Reviewed-by on AI-coauthored commits.
# ABOUTME: Reason: AI-generated commits without human review are the #1 supply-chain regression vector.
set -euo pipefail
MSG_FILE="$1"
MSG="$(cat "${MSG_FILE}")"
FIRST="$(head -n1 "${MSG_FILE}")"
[[ "${FIRST}" =~ ^(Merge|Revert|fixup!|squash!|amend!) ]] && exit 0

CC='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test|security)(\([a-zA-Z0-9._/-]+\))?(!)?: .{1,100}$'
if ! [[ "${FIRST}" =~ ${CC} ]]; then
    echo "x Not Conventional Commits:" >&2
    echo "  ${FIRST}" >&2
    echo "  Expected: <type>(<scope>): <subject>   e.g. 'feat(api): add X'" >&2
    exit 1
fi

AI='Co-authored-by: (Claude|Cursor|GitHub Copilot|Aider|Codeium|Windsurf|Devin)'
if echo "${MSG}" | grep -Eiq "${AI}|Generated with Claude Code|Generated by Claude Code"; then
    if ! echo "${MSG}" | grep -Eq '^(Reviewed-by|Signed-off-by): .+<.+@.+>'; then
        echo "x AI-generated commit requires a human Reviewed-by or Signed-off-by trailer." >&2
        echo "  Append:  Reviewed-by: Your Name <you@example.com>" >&2
        exit 1
    fi
fi
exit 0
